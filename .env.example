# Copy to .env for local runs. In production, set these as Railway variables.
# Never commit .env. Never paste real values into prompts, logs or issues.

# --- Core ---
ANTHROPIC_API_KEY=                # worker only; API billing, never a subscription login
# Local compose Postgres (docker compose up -d). On Railway this is ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgresql://artec:artec-local-only@127.0.0.1:54329/artec_agents
BRAND=artec
PUBLISHING_ENABLED=false          # global kill switch; must stay false until Phase 4
LOG_LEVEL=INFO

# --- Worker ---
WORKER_HEARTBEAT_SECONDS=60
WORKER_SMOKE_ON_BOOT=true         # Phase 0: one Haiku call per deployment, skipped on restart
SMOKE_MODEL=claude-haiku-5-5
ASSET_TAGGING_CONCURRENCY=2       # vision tagging calls in parallel (Haiku)
PUBLIC_BASE_URL=                  # e.g. https://web-production-0c48.up.railway.app; asset media URLs

# --- Tests (pytest) ---
# TEST_DATABASE_URL=postgresql://artec:artec-local-only@127.0.0.1:54329/artec_agents_test

# --- Approval inbox (FastAPI web service) ---
INBOX_USERNAME=
INBOX_PASSWORD=
TOKEN_ENCRYPTION_KEY=             # used to encrypt platform tokens at rest

# --- Assets: Google Drive (Shared Drive asset bank) ---
GOOGLE_SERVICE_ACCOUNT_JSON=      # service account key JSON, base64-encoded; Drive read-only
# The Drive folder ID lives in brands/artec.yaml. Share only that folder with the service
# account, as Viewer.

# --- Images: fal.ai ---
FAL_KEY=

# --- Meta: Instagram + Facebook Page ---
META_APP_ID=
META_APP_SECRET=
IG_USER_ID=
FB_PAGE_ID=

# --- TikTok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- LinkedIn ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORG_URN=                 # urn:li:organization:<id>
